{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "team1",
  "homepage": "https://github.com/avalancheteam1/design-system",
  "items": [
    {
      "name": "team1-theme",
      "type": "registry:style",
      "title": "Team1 theme tokens",
      "description": "Team1 3.0.0 design tokens: CSS custom properties (dark default, light option) and the Tailwind 4 @theme mapping. Import both after `@import \"tailwindcss\"`. Fonts are not shipped: load Kanit 500, Inter and JetBrains Mono from an authorized source.",
      "dependencies": [],
      "files": [
        {
          "path": "tokens/design-tokens.css",
          "type": "registry:file",
          "target": "styles/team1/design-tokens.css"
        },
        {
          "path": "tokens/tailwind-theme.css",
          "type": "registry:file",
          "target": "styles/team1/tailwind-theme.css"
        }
      ]
    },
    {
      "name": "utils",
