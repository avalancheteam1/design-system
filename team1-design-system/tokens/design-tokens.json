{
  "$description": "Team1 Design System 3.0.0 design tokens. W3C Design Tokens Community Group format ($type/$value). This file is the single source for the generated CSS custom properties (design-tokens.css) and the Tailwind 4 theme (tailwind-theme.css); regenerate them with scripts/build_tokens.py.",
  "$extensions": {
    "network.team1": {
      "format": "team1-design-tokens/3",
      "version": "3.0.0",
      "authoritySnapshot": "2026-11-20",
      "decisionRecord": "Web and product decisions Q1–Q13 approved by Giacomo Barbieri (Team1), 2026-11-20, after a review of the live Team1 web properties. See references/digital-and-web.md and CHANGELOG.md.",
      "generated": [
        "tokens/design-tokens.css",
        "tokens/tailwind-theme.css"
      ],
      "retired": {
        "#FF394A": "Retired Team1 red; historical v1 content signal only. Replace with color.brand.primary (and web shadow tokens for glows).",
        "#E84142": "Not Team1 primary; Avalanche-origin or inherited presentation context only. Replace with color.brand.primary on Team1 web properties.",
        "#e02d3d": "2.x brand hover. Retired in 3.0.0: it is visually identical to #E6212F (4.55 vs 4.54 against white). Use web.state.button tokens.",
        "#6c757d": "2.x light tertiary text. Retired in 3.0.0 for web: 4.31:1 on #F5F5F9 fails AA. Use web.theme.light.textMuted.",
        "0 0 0 3px rgba(230, 33, 47, 0.1)": "2.x focus ring. Retired in 3.0.0: invisible on black. Use web.focus."
      }
    }
  },
